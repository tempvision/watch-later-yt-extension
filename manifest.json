{
  "manifest_version": 3,
  "name": "Watch Later Highlighter & Playlist Shortcuts",
  "version": "1.3",
  "description": "Highlights Watch later across YouTube and adds quick actions and playlist shortcuts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["constants.js", "settings.js", "playlist-shortcuts.js", "menu-highlight.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://m.youtube.com/*"],
      "js": ["constants.js", "settings.js"],
      "run_at": "document_start"
    }
  ]
}
